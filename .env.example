# Токен бота от @BotFather
BOT_TOKEN=your_bot_token_here

# Если Telegram API недоступен напрямую, можно указать прокси
HTTP_PROXY=
HTTPS_PROXY=

# Ваш Telegram User ID (владелец бота)
OWNER_ID=0

# Хранение логов в днях (0 - бессрочно)
CACHE_DAYS=30

# Название бота/инстанса — показывается в приветствии бота
BOT_NAME=iSeeAll

# Ссылка на репозиторий — автоматически указывается в описании бота
REPO_URL=https://github.com/iSeeAll-bot/iSeeAll
